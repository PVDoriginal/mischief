packages: 
  ./mischief-ecs
  ./mischief-sdl
  ./mischief-input 
  ./mischief-math 
  ./mischief-assets 
  ./mischief-render 

with-compiler: ghc-9.12

package mischief-ecs
  optimization: 2
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
               -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
               -Wno-name-shadowing 

package mischief-sdl
  optimization: 2
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
               -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
               -Wno-name-shadowing 


package mischief-input
  optimization: 2
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
               -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
               -Wno-name-shadowing 

package mischief-math 
  optimization: 2
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
               -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
               -Wno-name-shadowing 

package mischief-assets 
  optimization: 2
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
               -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
               -Wno-name-shadowing 

package mischief-render 
  optimization: 2
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
               -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
               -Wno-name-shadowing

source-repository-package
  type: git
  location: https://github.com/klukaszek/sdl3-hs
  tag: d4a6b6e21f48cafb40028537a6cc9f55aa0943d3
